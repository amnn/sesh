{
  "name": "smth-workspace",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "pi": {
    "extensions": [
      "./extensions/pi-smth/index.ts"
    ],
    "skills": [
      "./extensions/pi-smth/skills"
    ]
  },
  "scripts": {
    "test": "tsx --test \"extensions/*/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm test && pnpm --recursive run smoke && pnpm audit"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "prettier": "3.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  }
}
